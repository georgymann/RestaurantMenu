<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:RestaurantMenu"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="520"
        d:DesignHeight="620"
        x:Class="RestaurantMenu.EditDishWindow"
        Title="Редактирование блюда"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="#8B8FA8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>
        <Style Selector="Border.readonly-field">
            <Setter Property="Background" Value="#0B141D"/>
            <Setter Property="BorderBrush" Value="#1C2631"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>
        <Style Selector="TextBox.editor-input">
            <Setter Property="Background" Value="#0E1722"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28323F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Border.param-pill">
            <Setter Property="Background" Value="#1C2631"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
        <Style Selector="Button.primary-button">
            <Setter Property="Background" Value="#F5C05E"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#F5C05E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFD17A"/>
            <Setter Property="BorderBrush" Value="#FFD17A"/>
        </Style>
        <Style Selector="Button.ghost-button">
            <Setter Property="Background" Value="#1C2631"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#2B3644"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ghost-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#24303D"/>
        </Style>
    </Window.Styles>

    <Border Background="#08111A" Padding="28">
        <StackPanel Spacing="18">

            <StackPanel Spacing="8">
                <TextBlock Text="РЕДАКТИРОВАНИЕ БЛЮДА" FontSize="12" FontWeight="SemiBold"
                           LetterSpacing="0.6" Foreground="#8B8FA8"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="DishNameText" Text="" FontSize="24" FontWeight="Bold"
                               Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border CornerRadius="8" Padding="11,5" Background="#3A2F18"
                            BorderBrush="#6E5824" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DishTypeText" Text="" Foreground="#F3C66D"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Read-only: name & category -->
            <Grid ColumnDefinitions="*,14,*">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Classes="field-label" Text="НАЗВАНИЕ"/>
                    <Border Classes="readonly-field">
                        <TextBlock x:Name="ReadonlyNameText" Text="" Foreground="#CBD5E1"
                                   FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Classes="field-label" Text="КАТЕГОРИЯ"/>
                    <Border Classes="readonly-field">
                        <TextBlock x:Name="ReadonlyCategoryText" Text="" Foreground="#CBD5E1" FontSize="14"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Read-only parameters -->
            <StackPanel Spacing="8">
                <TextBlock Classes="field-label" Text="ПАРАМЕТРЫ"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="param-pill">
                        <TextBlock x:Name="PortionText" Text="" Foreground="#CBD5E1" FontSize="13"/>
                    </Border>
                    <Border Classes="param-pill">
                        <TextBlock x:Name="CaloriesText" Text="" Foreground="#CBD5E1" FontSize="13"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Editable: description -->
            <StackPanel Spacing="8">
                <TextBlock Classes="field-label" Text="ОПИСАНИЕ"/>
                <TextBox x:Name="DescriptionBox" Classes="editor-input"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92"/>
            </StackPanel>

            <!-- Editable: price & availability -->
            <Grid ColumnDefinitions="*,14,Auto">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Classes="field-label" Text="ЦЕНА, ₽"/>
                    <TextBox x:Name="PriceBox" Classes="editor-input"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Classes="field-label" Text="ДОСТУПНОСТЬ"/>
                    <CheckBox x:Name="AvailableCheck" Content="В наличии" Foreground="#CBD5E1"
                              VerticalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Text="" Foreground="#F87171" FontSize="13"
                       TextWrapping="Wrap" IsVisible="False"/>

            <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
                <Button Grid.Column="0" Classes="ghost-button" Content="Отмена"
                        HorizontalAlignment="Stretch" Click="Cancel"/>
                <Button Grid.Column="2" Classes="primary-button" Content="Сохранить"
                        HorizontalAlignment="Stretch" Click="Save"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
