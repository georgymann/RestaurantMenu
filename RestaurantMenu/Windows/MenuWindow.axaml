<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:RestaurantMenu"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="760"
        x:Class="RestaurantMenu.MenuWindow"
        Title="Меню"
        Width="1280"
        Height="760"
        CanResize="False"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="Foreground" Value="#8B8FA8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
        </Style>

        <Style Selector="TextBlock.col-header">
            <Setter Property="Foreground" Value="#8B8FA8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.sidebar-field">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0E1722"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28323F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBox.sidebar-combo">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0E1722"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28323F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Sidebar navigation -->
        <Style Selector="Button.nav-button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#16212E"/>
        </Style>
        <Style Selector="Button.nav-button.active">
            <Setter Property="Background" Value="#3A2F18"/>
            <Setter Property="BorderBrush" Value="#6E5824"/>
            <Setter Property="Foreground" Value="#F3C66D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.nav-button.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#43371C"/>
        </Style>

        <Style Selector="Button.sidebar-save-button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3C66D"/>
            <Setter Property="BorderBrush" Value="#8F6B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.sidebar-save-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#241D0F"/>
        </Style>

        <Style Selector="Button.add-dish-button">
            <Setter Property="Background" Value="#F5C05E"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#F5C05E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.add-dish-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFD17A"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#FFD17A"/>
        </Style>

        <Style Selector="TextBox.filter-input">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#0E1722"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28323F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="44,0,14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.filter-input /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#AEB6C4"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dropdown list styling -->
        <Style Selector="ComboBox /template/ TextBlock#PlaceholderTextBlock">
            <Setter Property="Foreground" Value="#AEB6C4"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="#E5E9F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2631"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A2F18"/>
            <Setter Property="Foreground" Value="#F3C66D"/>
        </Style>
        <Style Selector="ComboBox.filter-combo /template/ PathIcon">
            <Setter Property="Foreground" Value="#AEB6C4"/>
        </Style>
        <Style Selector="ComboBox.sidebar-combo /template/ PathIcon">
            <Setter Property="Foreground" Value="#AEB6C4"/>
        </Style>

        <Style Selector="ComboBox.filter-combo">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#0E1722"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#28323F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox.dish-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.dish-list ListBoxItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.dish-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.dish-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#16212E"/>
        </Style>
        <Style Selector="ListBox.dish-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#131E29"/>
        </Style>

        <Style Selector="Border.param-pill">
            <Setter Property="Background" Value="#1C2631"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>

        <Style Selector="Button.dots-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B8FA8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.dots-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2631"/>
        </Style>

        <Style Selector="Button.secondary-button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#1C2631"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#2B3644"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.secondary-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#24303D"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260,*"
          Background="#08111A">

        <!-- sidebar -->
        <Border Grid.Column="0"
                Background="#0E1722"
                BorderBrush="#16212E"
                BorderThickness="0,0,1,0"
                Padding="22">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            Margin="0,4,0,34"
                            HorizontalAlignment="Center"
                            Spacing="2">
                    <Viewbox Width="100" Height="70" HorizontalAlignment="Center">
                        <Canvas Width="120" Height="84">
                            <Ellipse Canvas.Left="53" Canvas.Top="8" Width="14" Height="14"
                                     Stroke="#F3C66D" StrokeThickness="4" Fill="Transparent"/>
                            <Path Data="M60,22 L60,30" Stroke="#F3C66D" StrokeThickness="4" StrokeLineCap="Round"/>
                            <Path Data="M22,60 C24,36 41,26 60,26 C79,26 96,36 98,60"
                                  Stroke="#F3C66D" StrokeThickness="5" StrokeLineCap="Round" Fill="Transparent"/>
                            <Path Data="M14,69 L106,69" Stroke="#F3C66D" StrokeThickness="5" StrokeLineCap="Round"/>
                            <Path Data="M20,76 L100,76" Stroke="#F3C66D" StrokeThickness="3" StrokeLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="RESTAURANT" Foreground="#F3C66D" FontSize="22" FontWeight="Bold"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="MENU" Foreground="#F3C66D" FontSize="22" FontWeight="Bold"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Establishment selector -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,22">
                    <TextBlock Classes="section-label" Text="ЗАВЕДЕНИЕ"/>
                    <Grid>
                        <TextBox x:Name="SidebarEstablishmentTextBox"
                                 Classes="sidebar-field"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>

                <!-- Menu selector -->
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,26">
                    <TextBlock Classes="section-label" Text="МЕНЮ"/>
                    <ComboBox x:Name="MenuTypeComboBox"
                              Classes="sidebar-combo"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="ChangeMenuType"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="3" Spacing="6">
                    <Button Classes="nav-button active">
                        <Grid ColumnDefinitions="28,*">
                            <Viewbox Grid.Column="0" Width="18" Height="18"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="18" Height="18">
                                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="16" Height="16"
                                             Stroke="#F3C66D" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="7" Height="7"
                                             Stroke="#F3C66D" StrokeThickness="1.3" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="Блюда" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Classes="nav-button" Click="OpenEstablishmentInfo">
                        <Grid ColumnDefinitions="28,*">
                            <Viewbox Grid.Column="0" Width="18" Height="18"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="18" Height="18">
                                    <Path Data="M2,7 L9,2 L16,7" Stroke="#8B8FA8" StrokeThickness="1.5"
                                          StrokeJoin="Round" Fill="Transparent"/>
                                    <Path Data="M2,16 L16,16" Stroke="#8B8FA8" StrokeThickness="1.5" StrokeLineCap="Round"/>
                                    <Path Data="M5,7 L5,16" Stroke="#8B8FA8" StrokeThickness="1.5"/>
                                    <Path Data="M9,7 L9,16" Stroke="#8B8FA8" StrokeThickness="1.5"/>
                                    <Path Data="M13,7 L13,16" Stroke="#8B8FA8" StrokeThickness="1.5"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="О заведении" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Save -->
                <Button Grid.Row="5"
                        Classes="sidebar-save-button"
                        HorizontalAlignment="Stretch"
                        Click="SaveMenu">
                    <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Path Data="M2,2 L11,2 L14,5 L14,14 L2,14 Z"
                                      Stroke="#F3C66D" StrokeThickness="1.4" StrokeJoin="Round" Fill="Transparent"/>
                                <Path Data="M5,2 L5,6 L11,6 L11,2" Stroke="#F3C66D" StrokeThickness="1.2" Fill="Transparent"/>
                                <Path Data="M5,9 L11,9" Stroke="#F3C66D" StrokeThickness="1.2" StrokeLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Сохранить меню" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===================== CONTENT ===================== -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*,Auto"
              Background="#08111A"
              ColumnDefinitions="34,*,34">

            <!-- Header -->
            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,30,0,22">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="WindowTitleText" Text="Блюда"
                               FontSize="34" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="WindowSubtitleText" Text="Просмотр и управление блюдами меню"
                               FontSize="14" Foreground="#8B8FA8"/>
                </StackPanel>

                <Button Grid.Column="1" Classes="add-dish-button" Height="46"
                        VerticalAlignment="Top" Click="OpenAddDishWindow">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Добавить блюдо" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filters -->
            <Grid Grid.Row="1" Grid.Column="1"
                  ColumnDefinitions="1.7*,14,*,14,*"
                  Margin="0,0,0,18">
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox" Classes="filter-input"
                             PlaceholderText="Поиск по названию..." TextChanged="SearchDishes"/>
                    <Canvas Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="14,0,0,0" IsHitTestVisible="False">
                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="12" Height="12"
                                 Stroke="#AEB6C4" StrokeThickness="2.5" Fill="Transparent"/>
                        <Path Data="M14,14 L20,20" Stroke="#AEB6C4" StrokeThickness="2.5" StrokeLineCap="Round"/>
                    </Canvas>
                </Grid>

                <ComboBox x:Name="CategoryComboBox" Grid.Column="2" Classes="filter-combo"
                          HorizontalAlignment="Stretch" SelectionChanged="FilterDishes"/>
                <ComboBox x:Name="AvailabilityComboBox" Grid.Column="4" Classes="filter-combo"
                          HorizontalAlignment="Stretch" SelectionChanged="FilterDishes"/>
            </Grid>

            <!-- Table card -->
            <Border Grid.Row="2" Grid.Column="1"
                    Background="#0F1923"
                    BorderBrush="#1C2631"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">

                    <!-- Header row -->
                    <Border Grid.Row="0" Background="#13202C"
                            BorderBrush="#1C2631" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid ColumnDefinitions="1.5*,1*,0.7*,1.9*,1.2*,0.7*,40" ColumnSpacing="12">
                            <TextBlock Classes="col-header" Text="НАЗВАНИЕ"/>
                            <TextBlock Grid.Column="1" Classes="col-header" Text="КАТЕГОРИЯ"/>
                            <TextBlock Grid.Column="2" Classes="col-header" Text="ЦЕНА"/>
                            <TextBlock Grid.Column="3" Classes="col-header" Text="ОПИСАНИЕ"/>
                            <TextBlock Grid.Column="4" Classes="col-header" Text="ПАРАМЕТРЫ"/>
                            <TextBlock Grid.Column="5" Classes="col-header" Text="ДОСТУПНО"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ListBox x:Name="DishesListBox" Grid.Row="1"
                             Classes="dish-list" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:DishView">
                                <Border BorderBrush="#1A2530" BorderThickness="0,0,0,1"
                                        Padding="20,14" MinHeight="68">
                                    <Grid ColumnDefinitions="1.5*,1*,0.7*,1.9*,1.2*,0.7*,40"
                                          ColumnSpacing="12">
                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#CBD5E1"
                                                   FontSize="14" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding Price}" Foreground="#F3C66D"
                                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding ShortDescription}"
                                                   Foreground="#9AA6B5" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border Classes="param-pill">
                                                <TextBlock Text="{Binding Portion}" Foreground="#CBD5E1" FontSize="13"/>
                                            </Border>
                                            <Border Classes="param-pill">
                                                <TextBlock Text="{Binding Calories}" Foreground="#CBD5E1" FontSize="13"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding AvailabilityBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Availability}" Foreground="#CBD5E1"
                                                       FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="6" Classes="dots-button" Width="32" Height="32"
                                                VerticalAlignment="Center">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Редактировать" Click="EditDish"/>
                                                    <MenuItem Header="Удалить" Click="DeleteDish"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <TextBlock Text="⋮" FontSize="20" Foreground="#8B8FA8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,16,0,28">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="9" Height="9" Fill="#22C55E" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusTextBlock" Text="Готово к работе"
                                   VerticalAlignment="Center" Foreground="#8B8FA8" FontSize="13"/>
                    </StackPanel>
                    <TextBlock Text="·" Foreground="#3A4655" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalTextBlock" VerticalAlignment="Center"
                               Foreground="#8B8FA8" FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="RemoveDishButton" Classes="secondary-button"
                        Content="Удалить позицию" Width="160" Click="RemoveSelectedDish"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
